# Stripe API Konfiguration
STRIPE_KEY=

# Unternehmensinformationen
STRIPE_NAME=Stripe Technology Europe, Limited

# Gebühren-Konfiguration
# Setze auf true, um alle Gebühren in einer einzigen Zeile zusammenzufassen
SUM_FEES=false

# Rechnungsnummern im Export aktivieren
# Setze auf true, um gefundene Stripe-Rechnungsnummern in die CSV zu schreiben
INCLUDE_INVOICE_NUMBER=false
# Optionaler Präfix, der vor jede Rechnungsnummer gesetzt wird (z. B. "STR-")
INVOICE_NUMBER_PREFIX=

# Methode für Datenquellen
# CSV = Liest aus import.csv (ursprüngliches Verhalten)
# API = Holt Transaktionen direkt von der Stripe API
STRIPE_METHOD=CSV
